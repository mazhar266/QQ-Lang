{"id":112,"name":"الإخلاص","transliteration":"Al-Ikhlas","translation":"The Sincerity","type":"meccan","total_verses":4,"verses":[{"id":1,"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","emlaei":"قل هو الله أحد","translation":"Say, \"He is Allah, [who is] One","transliteration":"Qul huwa Allahu ahadun"},{"id":2,"text":"ٱللَّهُ ٱلصَّمَدُ","emlaei":"الله الصمد","translation":"Allah, the Eternal Refuge","transliteration":"Allahu alssamadu"},{"id":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","emlaei":"لم يلد ولم يولد","translation":"He neither begets nor is born","transliteration":"Lam yalid walam yooladu"},{"id":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","emlaei":"ولم يكن له كفوا أحد","translation":"Nor is there to Him any equivalent","transliteration":"Walam yakun lahu kufuwan ahadun"}]}